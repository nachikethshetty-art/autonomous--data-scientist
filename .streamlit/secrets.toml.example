# Streamlit Cloud Secrets Template
# Copy this to your Streamlit Cloud secrets management dashboard
# Format: TOML

# API Configuration
API_URL = "https://your-api-deployment-url.com"  # Replace with your deployed API URL

# LLM Configuration (if needed)
OLLAMA_BASE_URL = "http://localhost:11434"  # Or your Ollama server URL
GOOGLE_API_KEY = "your-google-api-key-here"  # If using Google Generative AI

# Database Configuration (optional)
DATABASE_URL = "sqlite:///jobs.db"

# Feature Flags
ENABLE_PROBLEM_DETECTION = true
ENABLE_CHAT = true
ENABLE_REPORTS = true
